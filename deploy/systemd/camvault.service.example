[Unit]
Description=CamVault ONVIF/RTSP recorder
After=network-online.target
# If AList is a local systemd service, add After=alist.service so it stops afterwards.
Wants=network-online.target

[Service]
Type=simple
User=camvault
Group=camvault
WorkingDirectory=/opt/camvault
EnvironmentFile=/etc/camvault/camvault.env
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=camvault
Environment=CAMVAULT_SPOOL_DIRECTORY=/var/lib/camvault/spool
ExecStart=/usr/local/bin/uv run --project /opt/camvault --no-sync --no-dev camvault serve -c /etc/camvault/config.toml
Restart=always
RestartSec=5
TimeoutStopSec=150
# Send TERM to the parent first; it stops FFmpeg after arranging the final upload.
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# StateDirectory is persistent and writable under ProtectSystem=strict.
# Local backend: also change the following path to storage.root.
ReadWritePaths=-/srv/camvault-recordings

[Install]
WantedBy=multi-user.target
