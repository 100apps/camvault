[Unit]
Description=CamVault ONVIF/RTSP recorder
After=network-online.target
# If AList is a local systemd service, add After=alist.service so it stops afterwards.
Wants=network-online.target

[Service]
Type=simple
User=camvault
Group=camvault
WorkingDirectory=/opt/camvault
EnvironmentFile=/etc/camvault/camvault.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/bin/uv run --project /opt/camvault --no-sync --no-dev camvault serve -c /etc/camvault/config.toml
Restart=always
RestartSec=5
TimeoutStopSec=150
# Send TERM to the parent first; it stops FFmpeg after arranging the final upload.
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Local backend: change this to storage.root. The leading '-' permits WebDAV-only
# deployments to start even when no local recording directory exists.
ReadWritePaths=-/srv/camvault-recordings

[Install]
WantedBy=multi-user.target
