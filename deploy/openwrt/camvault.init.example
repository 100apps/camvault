#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /data/camvault/run.sh
    procd_set_param respawn 5 30 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="4096 4096"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger camvault
}
