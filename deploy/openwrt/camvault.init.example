#!/bin/sh /etc/rc.common

START=95
# Finish before AList (K10alist) and before the network is stopped.
STOP=09
USE_PROCD=1

# OpenWrt rcS normally allows ~15 seconds per shutdown hook. Configure
# server.shutdown_timeout_seconds=10; leave time to close the process afterwards.
CAMVAULT_TERM_TIMEOUT=14

start_service() {
    procd_open_instance
    procd_set_param command /data/camvault/run.sh
    procd_set_param respawn 5 30 5
    procd_set_param term_timeout "$CAMVAULT_TERM_TIMEOUT"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="4096 4096"
    procd_close_instance
}

stop_service() {
    # procd's delete call returns before the process exits. Capture its PID first,
    # because the service may disappear from ubus while the final PUT is in progress.
    CAMVAULT_STOP_PID="$(ubus call service list '{"name":"camvault"}' | jsonfilter -e '@.camvault.instances.*.pid')"
}

service_stopped() {
    # Keep the ordered K09 shutdown hook blocked so K10alist retains network access
    # until CamVault finishes. This also avoids overlapping recorders on restart.
    local remaining=$CAMVAULT_TERM_TIMEOUT
    while [ "$remaining" -gt 0 ]; do
        local alive=0
        for pid in $CAMVAULT_STOP_PID; do
            case "$pid" in ''|*[!0-9]*) continue ;; esac
            kill -0 "$pid" 2>/dev/null && alive=1
        done
        [ "$alive" -eq 0 ] && return 0
        sleep 1
        remaining=$((remaining - 1))
    done
    logger -t camvault "shutdown wait expired; pending RAM archives may not be uploaded"
}

service_triggers() {
    procd_add_reload_trigger camvault
}
